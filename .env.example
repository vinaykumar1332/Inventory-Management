# PWA Push Notification Configuration
# These are optional. Leave empty for demo mode (in-app notifications only).

# VAPID public key for Web Push notifications
# Generate with: npx web-push generate-vapid-keys
# NEVER expose the private key in the frontend
VITE_VAPID_PUBLIC_KEY=

# Backend push subscription API endpoint
# Example: https://api.example.com/push-subscriptions
VITE_PUSH_API_BASE_URL=
